diff --color -ruN a/application/modules/setup/sql/043a_1.7.2.sql b/application/modules/setup/sql/043a_1.7.2.sql
--- a/application/modules/setup/sql/043a_1.7.2.sql
+++ b/application/modules/setup/sql/043a_1.7.2.sql
@@ -0,0 +1,10 @@
+-- Gabbaya (patch 0004-oidc-sso): single sign-on (OpenID Connect) schema on 1.7.2.
+-- Upstream carries the same change in its next version file; IF NOT EXISTS keeps this
+-- migration safe to run on a database that already has the columns (MariaDB).
+ALTER TABLE `ip_users`
+    MODIFY COLUMN `user_password` VARCHAR(60) NULL,
+    ADD COLUMN IF NOT EXISTS `user_auth_provider` VARCHAR(20) NOT NULL DEFAULT 'local' AFTER `user_psalt`,
+    ADD COLUMN IF NOT EXISTS `user_oidc_sub` VARCHAR(255) NULL AFTER `user_auth_provider`;
+
+ALTER TABLE `ip_users`
+    ADD UNIQUE INDEX IF NOT EXISTS `idx_user_oidc_sub` (`user_oidc_sub`);
