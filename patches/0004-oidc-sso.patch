+    /**
+     * Start single sign-on at the OpenID Connect provider.
+     */
+    public function oidc_login()
+    {
+        $this->load->library('oidc');
+
+        if ( ! $this->oidc->is_enabled()) {
+            $this->session->set_flashdata('alert_error', trans('oidc_error_not_configured'));
+            redirect('sessions/login?local=1');
+        }
+
+        try {
+            $this->oidc->start_login();
+        } catch (Throwable $e) {
+            log_message('error', 'OIDC: could not start login: ' . sanitize_for_logging($e->getMessage()));
+            $this->session->set_flashdata('alert_error', trans('oidc_error_auth_failed'));
+            redirect('sessions/login?local=1');
+        }
+    }
+
+    /**
+     * Return endpoint of the OpenID Connect provider.
+     */
+    public function oidc_callback()
+    {
+        $this->load->library('oidc');
+        $this->load->helper('file_security');
+
+        if ( ! $this->oidc->is_enabled()) {
+            $this->session->set_flashdata('alert_error', trans('oidc_error_not_configured'));
+            redirect('sessions/login?local=1');
+        }
+
+        if ($this->_is_ip_rate_limited_login()) {
+            log_message('warning', 'OIDC login IP rate limit exceeded from: ' . sanitize_for_logging($this->input->ip_address()));
+            $this->_oidc_fail('oidc_error_auth_failed');
+        }
+
+        try {
+            $claims = $this->oidc->complete_login();
+        } catch (Throwable $e) {
+            log_message('error', 'OIDC: callback failed: ' . sanitize_for_logging($e->getMessage()));
+            $this->_oidc_fail('oidc_error_auth_failed');
+        }
+
+        $user = $this->oidc->resolve_user($claims);
+        if ( ! $user) {
+            $this->_oidc_fail('oidc_error_user_not_found');
+        }
+
+        if ((int) $user->user_active !== 1) {
+            $this->_oidc_fail('oidc_error_user_inactive');
+        }
+
+        $this->load->model('mdl_sessions');
+        $this->mdl_sessions->start_session($user);
+        $this->_reset_ip_login_attempts();
+
+        $this->_redirect_after_login();
     }
 
