diff --color -ruN a/application/libraries/Oidc.php b/application/libraries/Oidc.php
--- a/application/libraries/Oidc.php
+++ b/application/libraries/Oidc.php
@@ -0,0 +1,236 @@
+<?php
+
+if ( ! defined('BASEPATH')) {
+    exit('No direct script access allowed');
+}
+
+use Jumbojett\OpenIDConnectClient;
+
+/*
+ * InvoicePlane
+ *
+ * @author		InvoicePlane Developers & Contributors
+ * @copyright	Copyright (c) 2012 - 2018 InvoicePlane.com
+ * @license		https://invoiceplane.com/license.txt
+ * @link		https://invoiceplane.com
+ */
+
+/**
+ * OpenID Connect single sign-on.
+ *
+ * Based on the OIDC implementation by DJBenson (InvoicePlane#1448), rebuilt on the
+ * current session handling. Configuration comes from OIDC_* environment/ipconfig keys
+ * first, then from the settings stored in ip_settings.
+ */
+#[AllowDynamicProperties]
+class Oidc
+{
+    private $CI;
+
+    private ?OpenIDConnectClient $client = null;
+
+    private bool $enabled;
+
+    private string $provider_url;
+
+    private string $client_id;
+
+    private string $client_secret;
+
+    public function __construct()
+    {
+        $this->CI = &get_instance();
+        $this->CI->load->library('crypt');
+        $this->CI->load->helper('file_security');
+
+        $env_enabled   = (string) env('OIDC_ENABLED');
+        $this->enabled = $env_enabled !== ''
+            ? env_bool('OIDC_ENABLED')
+            : get_setting('oidc_enabled') === '1';
+
+        $this->provider_url = rtrim((string) (env('OIDC_PROVIDER_URL') ?: get_setting('oidc_provider_url')), '/');
+        $this->client_id    = (string) (env('OIDC_CLIENT_ID') ?: get_setting('oidc_client_id'));
+
+        $secret = (string) env('OIDC_CLIENT_SECRET');
+        if ($secret === '' && get_setting('oidc_client_secret') !== '') {
+            $secret = (string) $this->CI->crypt->decode(get_setting('oidc_client_secret'));
+        }
+
+        $this->client_secret = $secret;
+    }
+
+    public function is_enabled(): bool
+    {
+        return $this->enabled
+            && $this->provider_url !== ''
+            && $this->client_id !== ''
+            && $this->client_secret !== '';
+    }
+
+    public function is_local_login_allowed(): bool
+    {
+        return ! $this->is_enabled() || get_setting('oidc_allow_local_login', '1') === '1';
+    }
+
+    public function is_auto_redirect_enabled(): bool
+    {
+        return $this->is_enabled() && get_setting('oidc_auto_redirect_login', '0') === '1';
+    }
+
+    public function button_text(): string
+    {
+        $text = get_setting('oidc_button_text');
+
+        return $text !== '' ? $text : trans('oidc_login');
+    }
+
+    /**
+     * Redirect the browser to the provider (does not return).
+     */
+    public function start_login(): void
+    {
+        $this->client()->authenticate();
+    }
+
+    /**
+     * Complete the authorization code flow and return the identity claims.
+     *
+     * The library validates state, nonce, PKCE and the ID token (signature, iss, aud, exp).
+     *
+     * @return array{sub: string, email: ?string, email_verified: mixed, name: ?string, preferred_username: ?string}
+     */
+    public function complete_login(): array
+    {
+        $client = $this->client();
+        $client->authenticate();
+
+        $user_info = $client->requestUserInfo();
+
+        $name = trim((string) ($user_info->name ?? ''));
+        if ($name === '') {
+            $name = trim(($user_info->given_name ?? '') . ' ' . ($user_info->family_name ?? ''));
+        }
+
+        return [
+            'sub'                => (string) $client->getVerifiedClaims('sub'),
+            'email'              => isset($user_info->email) ? (string) $user_info->email : null,
+            'email_verified'     => $user_info->email_verified ?? null,
+            'name'               => $name !== '' ? $name : null,
+            'preferred_username' => isset($user_info->preferred_username) ? (string) $user_info->preferred_username : null,
+        ];
+    }
+
+    /**
+     * Resolve the InvoicePlane account for the provider identity.
+     *
+     * Order: stored subject, then (verified) email of exactly one account, then optional
+     * auto-creation. Returns null when no account may be used.
+     */
+    public function resolve_user(array $claims): ?object
+    {
+        if ($claims['sub'] === '') {
+            log_message('error', 'OIDC: identity without sub claim');
+
+            return null;
+        }
+
+        $user = $this->CI->db->where('user_oidc_sub', $claims['sub'])->get('ip_users')->row();
+        if ($user) {
+            return $user;
+        }
+
+        if (empty($claims['email'])) {
+            return null;
+        }
+
+        if (get_setting('oidc_require_email_verified', '1') === '1' && ! $this->is_true($claims['email_verified'])) {
+            log_message('error', 'OIDC: email not verified for sub ' . sanitize_for_logging($claims['sub']));
+
+            return null;
+        }
+
+        $matches = $this->CI->db->where('user_email', $claims['email'])->get('ip_users')->result();
+        if (count($matches) === 1) {
+            $this->link_user((int) $matches[0]->user_id, $claims['sub']);
+
+            return $this->CI->db->where('user_id', $matches[0]->user_id)->get('ip_users')->row();
+        }
+
+        if (count($matches) > 1) {
+            log_message('error', 'OIDC: email matches more than one account, not linking sub ' . sanitize_for_logging($claims['sub']));
+
+            return null;
+        }
+
+        if (get_setting('oidc_auto_create_users', '0') === '1') {
+            return $this->create_user($claims);
+        }
+
+        return null;
+    }
+
+    private function client(): OpenIDConnectClient
+    {
+        if ($this->client !== null) {
+            return $this->client;
+        }
+
+        $client = new OpenIDConnectClient($this->provider_url, $this->client_id, $this->client_secret);
+        $client->setRedirectURL(site_url('sessions/oidc_callback'));
+        $client->setCodeChallengeMethod('S256');
+
+        $scopes = array_filter(explode(' ', (string) get_setting('oidc_scopes', 'openid email profile')));
+        $client->addScope($scopes);
+
+        $methods = array_filter(array_map('trim', explode(',', (string) get_setting('oidc_token_auth_methods', 'client_secret_basic,client_secret_post'))));
+        $client->setTokenEndpointAuthMethodsSupported($methods);
+
+        if (get_setting('oidc_verify_ssl', '1') !== '1') {
+            $client->setVerifyHost(false);
+            $client->setVerifyPeer(false);
+        }
+
+        return $this->client = $client;
+    }
+
+    private function link_user(int $user_id, string $sub): void
+    {
+        $this->CI->db->where('user_id', $user_id)->update('ip_users', [
+            'user_oidc_sub'      => $sub,
+            'user_auth_provider' => 'oidc',
+        ]);
+    }
+
+    private function create_user(array $claims): ?object
+    {
+        $name = $claims['name'] ?? $claims['preferred_username'] ?? $claims['email'];
+        $now  = date('Y-m-d H:i:s');
+
+        $inserted = $this->CI->db->insert('ip_users', [
+            'user_type'          => (int) get_setting('oidc_default_user_type', '2') === 1 ? 1 : 2,
+            'user_active'        => 1,
+            'user_email'         => $claims['email'],
+            'user_name'          => $name,
+            'user_password'      => null,
+            'user_psalt'         => null,
+            'user_auth_provider' => 'oidc',
+            'user_oidc_sub'      => $claims['sub'],
+            'user_language'      => 'system',
+            'user_date_created'  => $now,
+            'user_date_modified' => $now,
+        ]);
+
+        if ( ! $inserted) {
+            log_message('error', 'OIDC: could not create user for sub ' . sanitize_for_logging($claims['sub']));
+
+            return null;
+        }
+
+        return $this->CI->db->where('user_id', $this->CI->db->insert_id())->get('ip_users')->row();
+    }
+
+    private function is_true($value): bool
+    {
+        return filter_var($value, FILTER_VALIDATE_BOOLEAN, FILTER_NULL_ON_FAILURE) === true;
+    }
+}
